{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "void/env",
      "vite/client"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "env.ts",
    "middleware",
    "pages",
    "routes",
    "server",
    "void.config.ts",
    "vite.config.ts"
  ]
}
